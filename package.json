{
  "name": "potato-mana",
  "private": true,
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm -r --parallel --filter ./apps/* dev",
    "build": "pnpm --filter @potato-mana/web build && pnpm --filter @potato-mana/server build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "lint": "biome check ."
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15"
  }
}
