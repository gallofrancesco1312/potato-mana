# Hostname served by Traefik (compose.yaml labels) and its public URL
APP_HOST=mana-potato.home.potato
PUBLIC_URL=https://mana-potato.home.potato
# Image tag in the Forgejo registry
TAG=latest

# Authelia OIDC (client registered in authelia/configuration.yml, see README)
OIDC_ISSUER=https://auth.home.potato
OIDC_CLIENT_ID=mana-potato
OIDC_CLIENT_SECRET=
ADMIN_GROUP=admins
# Homelab CA so Node trusts https://auth.home.potato
CA_CERT_FILE=/opt/services/network/traefik/certs/potato.crt

# Optional ntfy notifications for job failures
NTFY_URL=
NTFY_TOPIC=
NTFY_TOKEN=

BACKUP_CRON=30 2 * * *
BACKUP_KEEP_DAYS=14
