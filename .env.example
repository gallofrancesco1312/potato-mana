# Hostname served by Traefik (compose.yaml labels)
APP_HOST=mana-potato.home.potato
# Image tag in the Forgejo registry
TAG=latest

# Authelia forward-auth (see README). TRUSTED_PROXIES = Traefik IP/CIDR on the proxy network.
FORWARD_AUTH=true
TRUSTED_PROXIES=172.18.0.0/16
ADMIN_GROUP=admins

# Optional ntfy notifications for job failures
NTFY_URL=
NTFY_TOPIC=
NTFY_TOKEN=

BACKUP_CRON=30 2 * * *
BACKUP_KEEP_DAYS=14
